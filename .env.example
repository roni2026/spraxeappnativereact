# Supabase project URL (defaults to the Spraxe project if unset)
EXPO_PUBLIC_SUPABASE_URL=https://kybgrsqqvejbvjediowo.supabase.co

# Supabase anon/public API key (REQUIRED — get it from your Supabase project settings)
